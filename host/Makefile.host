# Host (Linux/macOS) SDL build — included from the project Makefile.
#
#   make host                     # SDL2
#   make host HOST_SDL=3          # SDL3
#   ./zelda3_host                 # needs ./homebrews/zelda3_assets.dat (or HOST_SD=…)
#
# Requires: pkg-config + libsdl2-dev / sdl2 (or sdl3).
# Note: host links all .rodata normally (no zelda3.ro patch step).

HOST_SDL   ?= 2
HOST_SCALE ?= 2
HOST_CC    ?= cc

HOST_BUILD_DIR := build/host/$(PROJECT_KIND)_sdl$(HOST_SDL)
HOST_BIN := $(CORE_NAME)_host

ifeq ($(HOST_SDL),3)
HOST_SDL_PC := sdl3
else ifeq ($(HOST_SDL),2)
HOST_SDL_PC := sdl2
else
$(error HOST_SDL must be 2 or 3 (got '$(HOST_SDL)'))
endif

HOST_PKG_CFLAGS := $(shell PKG_CONFIG_PATH="/opt/homebrew/lib/pkgconfig:/usr/local/lib/pkgconfig:$${PKG_CONFIG_PATH}" pkg-config --cflags $(HOST_SDL_PC) 2>/dev/null)
HOST_PKG_LIBS   := $(shell PKG_CONFIG_PATH="/opt/homebrew/lib/pkgconfig:/usr/local/lib/pkgconfig:$${PKG_CONFIG_PATH}" pkg-config --libs $(HOST_SDL_PC) 2>/dev/null)
ifeq ($(HOST_PKG_LIBS),)
ifeq ($(HOST_SDL),2)
HOST_PKG_CFLAGS := $(shell sdl2-config --cflags 2>/dev/null)
HOST_PKG_LIBS   := $(shell sdl2-config --libs 2>/dev/null)
endif
endif
HOST_PKG_LIBS   := $(filter-out -lSDL2main,$(HOST_PKG_LIBS))
ifeq ($(HOST_PKG_LIBS),)
ifneq ($(filter host,$(MAKECMDGOALS)),)
$(warning pkg-config $(HOST_SDL_PC) not found — host link may fail. Install SDL$(HOST_SDL) devel package.)
endif
endif

HOST_INC_ROOT := $(GNW_CORE_SDK)/include

HOST_DEFS := \
	-DHOST_BUILD=1 \
	-DHOST_SDL=$(HOST_SDL) \
	-DHOST_SCALE=$(HOST_SCALE) \
	-DSDL_MAIN_HANDLED=1 \
	-DIS_LITTLE_ENDIAN \
	-DGNW_DISABLE_COMPRESSION \
	$(CORE_C_DEFS)

HOST_INCLUDES := \
	-Ihost \
	-Ihost/stubs \
	-I$(GNW_CORE_SDK)/src \
	-I$(HOST_INC_ROOT)/Core/Inc \
	-I$(HOST_INC_ROOT)/Core/Inc/retro-go \
	-I$(HOST_INC_ROOT)/Core/Inc/porting \
	-I$(HOST_INC_ROOT)/Core/Src/porting/lib \
	-I$(HOST_INC_ROOT)/Core/Src/porting/lib/FatFs \
	$(CORE_C_INCLUDES) \
	$(HOST_PKG_CFLAGS)

HOST_CFLAGS := -O2 -g -Wall -Wextra -std=gnu11 \
	-include host/stubs/config.h \
	-include host/stubs/zelda3_host_sections.h \
	-include stddef.h \
	$(HOST_DEFS) $(HOST_INCLUDES) \
	$(filter-out -Wno-stack-usage,$(ZELDA3_WARN_OFF)) \
	-Wno-unused-parameter

HOST_SRCS := \
	$(CORE_C_SOURCES) \
	host/crc32.c \
	host/host_main.c \
	host/host_platform.c \
	host/host_emu.c \
	host/host_i18n.c \
	host/host_zelda3_stubs.c

# Preserve source directory layout so snes/ppu.c and src/main_zelda3.c do not clash.
HOST_OBJS := $(addprefix $(HOST_BUILD_DIR)/,$(HOST_SRCS:.c=.o))
HOST_DEPS := $(HOST_OBJS:.o=.d)

.PHONY: host host_clean

host: $(HOST_BIN)
	$(V)$(ECHO) "[ HOST ]" $(HOST_BIN) "(SDL$(HOST_SDL), PROJECT_KIND=$(PROJECT_KIND))"

$(HOST_BIN): $(HOST_OBJS)
	$(V)$(ECHO) [ LD HOST ] $@
	$(V)$(HOST_CC) -o $@ $(HOST_OBJS) $(HOST_PKG_LIBS)

$(HOST_BUILD_DIR)/%.o: %.c
	$(V)mkdir -p $(dir $@)
	$(V)$(ECHO) [ CC HOST ] $<
	$(V)$(HOST_CC) $(HOST_CFLAGS) -MMD -MP -MF"$(@:%.o=%.d)" -c $< -o $@

host_clean:
	$(V)rm -rf build/host
	$(V)rm -f $(HOST_BIN) $(CORE_NAME)_host

clean:: host_clean

-include $(HOST_DEPS)
